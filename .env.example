# =============================================================================
# YouTube Script Generator — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production deployment, set these as environment variables in
# Vercel (frontend) and Render (backend).
# =============================================================================

# ─── OpenRouter API Key (required for AI features) ──────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── JWT Secret (change in production) ──────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production

# ─── Better-Auth (for frontend auth) ────────────────────────────────────────
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (for social login) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Razorpay (for payments) ────────────────────────────────────────────────
# Get test keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local dev (Docker):
DATABASE_URL=postgresql://ysg_user:ysg_pass@postgres:5432/ysg_db?schema=public
# Production (Render/Neon): Replace with your external connection string
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public

# ─── Redis ──────────────────────────────────────────────────────────────────
# Local dev (Docker):
REDIS_URL=redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Production (Render/Upstash): Set REDIS_HOST, REDIS_PORT, REDIS_PASSWORD from provider

# ─── Frontend URLs ──────────────────────────────────────────────────────────
# Local dev:
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production (Vercel + Render):
# FRONTEND_URL=https://youtube-script-generator.vercel.app
# NEXT_PUBLIC_API_URL=https://ysg-backend.onrender.com

# ─── Admin Secret Key (for promoting users to admin role) ───────────────────
# Used by POST /api/auth/make-admin endpoint
# Generate a strong secret: openssl rand -base64 32
ADMIN_SECRET_KEY=your-admin-secret-key-change-in-production

# ─── Email (optional — for notifications) ───────────────────────────────────
# Get an API key at: https://resend.com
RESEND_API_KEY=your-resend-api-key