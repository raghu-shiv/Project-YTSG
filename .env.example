# OpenRouter API Key (required for AI features)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# JWT Secret (change in production)
JWT_SECRET=your-jwt-secret-change-in-production

# Better-Auth Secret (for frontend auth)
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay (for payments)
RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Database (PostgreSQL)
DATABASE_URL=postgresql://ysg_user:ysg_pass@postgres:5432/ysg_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin Secret Key (for promoting users to admin role via POST /auth/make-admin)
ADMIN_SECRET_KEY=your-admin-secret-key-change-in-production

# Email (optional - for notifications)
RESEND_API_KEY=your-resend-api-key
