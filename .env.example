# =============================================================================
# YouTube Script Generator — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production deployment, set these as environment variables in
# Vercel (frontend) and Render (backend).
# =============================================================================

# ─── OpenRouter API Key (required for AI features) ──────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── JWT Secret (change in production) ──────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production

# ─── Better-Auth (for frontend auth) ────────────────────────────────────────
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (for social login) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Razorpay (for payments) ────────────────────────────────────────────────
# Get test keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local dev (Docker):
DATABASE_URL=postgresql://ysg_user:ysg_pass@postgres:5432/ysg_db?schema=public

# ── Production: Supabase PostgreSQL ─────────────────────────────────────────
# 1. Go to Supabase Dashboard → Project Settings → Database
# 2. Copy the "Connection string" under "PgBouncer" (port 6543)
# 3. Replace [YOUR-PASSWORD] with your database password
# 4. Add ?pgbouncer=true&schema=public at the end
#
# Format:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
#
# Example:
#   DATABASE_URL=postgresql://postgres.abcd1234:my-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
#
# ⚠️ IMPORTANT: Use the PgBouncer connection string (port 6543), NOT the direct
#    connection (port 5432). Prisma needs PgBouncer for connection pooling.
# ⚠️ Make sure to include ?pgbouncer=true so Prisma knows to use PgBouncer mode.

# ── DIRECT_URL (required for schema pushes with Supabase PgBouncer) ─────────
# Prisma uses DIRECT_URL to bypass PgBouncer for schema operations (db push, migrate).
# This connects directly to your database (port 5432) instead of through the pooler (port 6543).
# Without this, "prisma db push" will hang/timeout because PgBouncer in transaction mode
# doesn't support DDL multi-statement operations like foreign key creation.
#
# 1. Go to Supabase Dashboard → Project Settings → Database
# 2. Copy the "Connection string" under "Direct connection" (port 5432)
# 3. Replace [YOUR-PASSWORD] with your database password
# 4. Add ?schema=public at the end (do NOT add pgBouncer=true)
#
# Format:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public
#
# Example:
#   DIRECT_URL=postgresql://postgres.abcd1234:my-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=public
#
# ⚠️ The DIRECT_URL and DATABASE_URL use the SAME credentials but DIFFERENT ports:
#    - DATABASE_URL → port 6543 (PgBouncer pooled connection)
#    - DIRECT_URL   → port 5432 (direct connection)

# ─── Redis ──────────────────────────────────────────────────────────────────
# Local dev (Docker):
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ── Production: Upstash Redis ───────────────────────────────────────────────
# 1. Go to Upstash Console → Create Database (select "Global" or a region)
# 2. Copy the following from the "REST API" section:
#    - UPSTASH_REDIS_REST_URL → extract the hostname
#    - UPSTASH_REDIS_REST_TOKEN → use as REDIS_PASSWORD
#
# Format:
#   REDIS_HOST=[your-database-name].upstash.io
#   REDIS_PORT=6379
#   REDIS_PASSWORD=[your-rest-token]
#   REDIS_TLS_ENABLED=true
#
# Example:
#   REDIS_HOST=us1-adequate-lion-12345.upstash.io
#   REDIS_PORT=6379
#   REDIS_PASSWORD=AbCdEfGhIjKlMnOpQrStUvWxYz123456
#   REDIS_TLS_ENABLED=true
#
# ⚠️ Upstash requires TLS, so REDIS_TLS_ENABLED must be "true" in production.

# ─── Frontend URLs ──────────────────────────────────────────────────────────
# Local dev:
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=https://yt-scripts-backend.onrender.com
# Production (Vercel + Render):
# FRONTEND_URL=https://www.yt-scripts.online
# NEXT_PUBLIC_API_URL=https://yt-scripts-backend.onrender.com

# ─── Admin Secret Key (for promoting users to admin role) ───────────────────
# Used by POST /api/auth/make-admin endpoint
# Generate a strong secret: openssl rand -base64 32
ADMIN_SECRET_KEY=your-admin-secret-key-change-in-production

# ─── Email (optional — for notifications) ───────────────────────────────────
# Get an API key at: https://resend.com
RESEND_API_KEY=your-resend-api-key