generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider     = "postgresql"
    url          = env("DATABASE_URL")
    // Direct URL bypasses PgBouncer for schema operations (migrations, push)
    // Uses Supabase direct connection (port 5432) instead of pooled (port 6543)
    // Required because PgBouncer in transaction mode doesn't support DDL multi-statements
    directUrl    = env("DIRECT_URL")
    // Required for Supabase PgBouncer connection pooling (transaction mode)
    // See: https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/database-connections/pgbouncer
    relationMode = "prisma"
}

enum AuthProvider {
    local
    google
}

enum UserRole {
    user
    admin
}

enum CreditTransactionType {
    purchase
    subscription_grant
    usage
    refund
}

enum SubscriptionPlan {
    free
    starter
    creator
    pro
    premium
}

enum SubscriptionStatus {
    active
    cancelled
    expired
}

enum PaymentStatus {
    created
    paid
    failed
    refunded
}

enum ScriptStatus {
    draft
    generating
    completed
    failed
}

enum VideoType {
    educational
    tech_review
    faceless
    general
}

model User {
    id               String       @id @default(uuid())
    email            String       @unique
    passwordHash     String?
    name             String?
    avatarUrl        String?
    phone            String?
    phoneVerified    Boolean      @default(false) @map("phone_verified")
    emailVerified    Boolean      @default(false) @map("email_verified")
    authProvider     AuthProvider @default(local)
    googleId         String?      @unique
    role             UserRole     @default(user)
    scriptCredits    Int          @default(0) @map("script_credits")
    thumbnailCredits Int          @default(0) @map("thumbnail_credits")
    createdAt        DateTime     @default(now()) @map("created_at")
    updatedAt        DateTime     @updatedAt @map("updated_at")

    creditTransactions CreditTransaction[]
    subscriptions      Subscription[]
    payments           Payment[]
    scripts            Script[]
    aiUsageLogs        AiUsageLog[]
    teamMembers        TeamMember[]
    otpVerifications   OtpVerification[]
    tokenVersion       Int                 @default(0) @map("token_version")

    passwordResetTokens PasswordResetToken[]

    @@map("users")
}

model OtpVerification {
    id        String   @id @default(uuid())
    userId    String   @map("user_id")
    target    String? // email or phone number
    type      String   @default("email") // "email" or "phone"
    otp       String
    expiresAt DateTime @map("expires_at")
    used      Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@map("otp_verifications")
}

model CreditTransaction {
    id           String                @id @default(uuid())
    userId       String                @map("user_id")
    type         CreditTransactionType
    amount       Int
    balanceAfter Int                   @map("balance_after")
    referenceId  String?               @map("reference_id")
    description  String?
    createdAt    DateTime              @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([createdAt])
    @@map("credit_transactions")
}

model Subscription {
    id                     String             @id @default(uuid())
    userId                 String             @map("user_id")
    plan                   SubscriptionPlan
    scriptCredits          Int                @default(0) @map("script_credits")
    thumbnailCredits       Int                @default(0) @map("thumbnail_credits")
    status                 SubscriptionStatus
    razorpaySubscriptionId String?            @map("razorpay_subscription_id")
    currentPeriodStart     DateTime?          @map("current_period_start")
    currentPeriodEnd       DateTime?          @map("current_period_end")
    createdAt              DateTime           @default(now()) @map("created_at")
    updatedAt              DateTime           @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, plan])
    @@map("subscriptions")
}

model Payment {
    id                String        @id @default(uuid())
    userId            String        @map("user_id")
    razorpayOrderId   String        @unique @map("razorpay_order_id")
    razorpayPaymentId String?       @map("razorpay_payment_id")
    amount            Decimal       @db.Decimal(10, 2)
    currency          String        @default("INR")
    status            PaymentStatus
    creditsPurchased  Int           @map("credits_purchased")
    createdAt         DateTime      @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("payments")
}

model Niche {
    id          String   @id @default(uuid())
    name        String
    description String?
    keywords    String[]
    createdAt   DateTime @default(now()) @map("created_at")

    scripts Script[] @relation("NicheScripts")
    team    Team?    @relation("TeamNiches", fields: [teamId], references: [id])
    teamId  String?

    @@index([teamId])
    @@map("niches")
}

model Script {
    id                   String       @id @default(uuid())
    userId               String       @map("user_id")
    nicheId              String?      @map("niche_id")
    title                String?
    topic                String
    content              String?
    outline              Json?
    status               ScriptStatus @default(draft)
    videoType            VideoType    @default(general) @map("video_type")
    wordCount            Int?         @map("word_count")
    estimatedDurationSec Int?         @map("estimated_duration_sec")
    modelUsed            String?      @map("model_used")
    creditsUsed          Int          @default(0) @map("credits_used")
    createdAt            DateTime     @default(now()) @map("created_at")
    updatedAt            DateTime     @updatedAt @map("updated_at")

    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    niche             Niche?             @relation("NicheScripts", fields: [nicheId], references: [id], onDelete: SetNull)
    versions          ScriptVersion[]
    seoSuggestions    SeoSuggestion?
    thumbnailConcepts ThumbnailConcept[]
    team              Team?              @relation("TeamScripts", fields: [teamId], references: [id])
    teamId            String?

    @@index([userId])
    @@index([nicheId])
    @@index([teamId])
    @@map("scripts")
}

model ScriptVersion {
    id            String   @id @default(uuid())
    scriptId      String   @map("script_id")
    content       String
    versionNumber Int      @map("version_number")
    createdAt     DateTime @default(now()) @map("created_at")

    script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

    @@index([scriptId])
    @@map("script_versions")
}

model SeoSuggestion {
    id               String   @id @default(uuid())
    scriptId         String   @unique @map("script_id")
    keywords         String[]
    hashtags         String[]
    tags             String[]
    titleSuggestions String[] @map("title_suggestions")
    createdAt        DateTime @default(now()) @map("created_at")

    script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

    @@map("seo_suggestions")
}

model ThumbnailConcept {
    id                    String   @id @default(uuid())
    scriptId              String   @map("script_id")
    conceptDescription    String   @map("concept_description")
    textOverlaySuggestion String?  @map("text_overlay_suggestion")
    imageUrl              String?  @map("image_url")
    createdAt             DateTime @default(now()) @map("created_at")

    script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

    @@index([scriptId])
    @@map("thumbnail_concepts")
}

model AiUsageLog {
    id               String   @id @default(uuid())
    userId           String   @map("user_id")
    endpoint         String
    model            String
    promptTokens     Int      @map("prompt_tokens")
    completionTokens Int      @map("completion_tokens")
    costUsd          Decimal  @map("cost_usd")
    createdAt        DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([createdAt])
    @@map("ai_usage_logs")
}

// Team / Workspace models
enum TeamRole {
    owner
    admin
    member
}

model Team {
    id          String   @id @default(uuid())
    name        String
    slug        String   @unique
    description String?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    members     TeamMember[]
    scripts     Script[]     @relation("TeamScripts")
    niches      Niche[]      @relation("TeamNiches")
    teamInvites TeamInvite[]

    @@map("teams")
}

model TeamMember {
    id        String   @id @default(uuid())
    teamId    String   @map("team_id")
    userId    String   @map("user_id")
    role      TeamRole @default(member)
    createdAt DateTime @default(now()) @map("created_at")

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([teamId, userId])
    @@index([userId])
    @@map("team_members")
}

model TeamInvite {
    id        String   @id @default(uuid())
    teamId    String   @map("team_id")
    email     String
    role      TeamRole @default(member)
    token     String   @unique
    accepted  Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")
    expiresAt DateTime @map("expires_at")

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

    @@index([teamId])
    @@map("team_invites")
}

model PasswordResetToken {
    id        String    @id @default(uuid())
    userId    String    @map("user_id")
    tokenHash String    @unique @map("token_hash")
    expiresAt DateTime  @map("expires_at")
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@map("password_reset_tokens")
}
